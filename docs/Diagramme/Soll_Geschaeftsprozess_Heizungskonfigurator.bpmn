    <bpmn:sequenceFlow id="F_Gateway_Cost" sourceRef="Gateway_Matching" targetRef="Task_Cost" name="Ja"/>
    <bpmn:sequenceFlow id="F_Cost_PDF" sourceRef="Task_Cost" targetRef="Task_PDF"/>
    <bpmn:sequenceFlow id="F_PDF_SaveYes" sourceRef="Task_PDF" targetRef="Task_SaveLead_Yes"/>
    <bpmn:sequenceFlow id="F_SaveYes_Email" sourceRef="Task_SaveLead_Yes" targetRef="Task_Email_AG_Yes"/>
    <bpmn:sequenceFlow id="F_Email_Download" sourceRef="Task_Email_AG_Yes" targetRef="Task_Download_PDF"/>
    <bpmn:sequenceFlow id="F_Download_End" sourceRef="Task_Download_PDF" targetRef="End_Offer"/>
    <bpmn:sequenceFlow id="F_Gateway_Mark" sourceRef="Gateway_Matching" targetRef="Task_MarkConsultation" name="Nein"/>
    <bpmn:sequenceFlow id="F_Mark_SaveNo" sourceRef="Task_MarkConsultation" targetRef="Task_SaveLead_No"/>
    <bpmn:sequenceFlow id="F_SaveNo_Email" sourceRef="Task_SaveLead_No" targetRef="Task_Email_AG_No"/>
    <bpmn:sequenceFlow id="F_Email_Inform" sourceRef="Task_Email_AG_No" targetRef="Task_InformCustomer"/>
    <bpmn:sequenceFlow id="F_Inform_End" sourceRef="Task_InformCustomer" targetRef="End_Consultation"/>
  </bpmn:process>
