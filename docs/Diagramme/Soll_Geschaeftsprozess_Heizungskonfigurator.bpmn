<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1clqaki" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:process id="Process_1g9xf3h" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Endkunde öffnet Heizungskonfigurator">
      <bpmn:outgoing>F_Start_Questions</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Questions" name="Endkunde beantwortet Fragen">
      <bpmn:extensionElements>
        <zeebe:userTask/>
      </bpmn:extensionElements>
      <bpmn:incoming>F_Start_Questions</bpmn:incoming>
      <bpmn:outgoing>F_Questions_Contact</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Contact" name="Endkunde gibt Kontaktdaten ein und stimmt Datenschutz zu">
      <bpmn:extensionElements>
        <zeebe:userTask/>
      </bpmn:extensionElements>
      <bpmn:incoming>F_Questions_Contact</bpmn:incoming>
      <bpmn:outgoing>F_Contact_Submit</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Submit" name="Endkunde klickt auf „Absenden“">
      <bpmn:extensionElements>
        <zeebe:userTask/>
      </bpmn:extensionElements>
      <bpmn:incoming>F_Contact_Submit</bpmn:incoming>
      <bpmn:outgoing>F_Submit_Calc</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_Calc" name="Wärmebedarf und passende Bausteine ermitteln">
      <bpmn:incoming>F_Submit_Calc</bpmn:incoming>
      <bpmn:outgoing>F_Calc_Gateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Matching" name="Passender Baustein vorhanden?">
      <bpmn:incoming>F_Calc_Gateway</bpmn:incoming>
      <bpmn:outgoing>F_Gateway_Cost</bpmn:outgoing>
      <bpmn:outgoing>F_Gateway_Mark</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Cost" name="Kostenschätzung berechnen">
      <bpmn:incoming>F_Gateway_Cost</bpmn:incoming>
      <bpmn:outgoing>F_Cost_PDF</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_PDF" name="PDF mit Kostenschätzung erstellen">
      <bpmn:incoming>F_Cost_PDF</bpmn:incoming>
      <bpmn:outgoing>F_PDF_SaveYes</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SaveLead_Yes" name="Lead mit Kontaktdaten, Antworten, Bausteinen und Kostenschätzung speichern">
      <bpmn:incoming>F_PDF_SaveYes</bpmn:incoming>
      <bpmn:outgoing>F_SaveYes_Email</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_Email_AG_Yes" name="E-Mail mit neuen Lead-Daten an AG senden">
      <bpmn:incoming>F_SaveYes_Email</bpmn:incoming>
      <bpmn:outgoing>F_Email_Download</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="Task_Download_PDF" name="PDF zum Download bereitstellen">
      <bpmn:incoming>F_Email_Download</bpmn:incoming>
      <bpmn:outgoing>F_Download_End</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_Offer" name="Prozess beendet">
      <bpmn:incoming>F_Download_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_MarkConsultation" name="Lead für persönliche Beratung markieren">
      <bpmn:incoming>F_Gateway_Mark</bpmn:incoming>
      <bpmn:outgoing>F_Mark_SaveNo</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SaveLead_No" name="Lead mit Kontaktdaten und Antworten ohne Angebot speichern">
      <bpmn:incoming>F_Mark_SaveNo</bpmn:incoming>
      <bpmn:outgoing>F_SaveNo_Email</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_Email_AG_No" name="E-Mail über Beratungsbedarf an AG senden">
      <bpmn:incoming>F_SaveNo_Email</bpmn:incoming>
      <bpmn:outgoing>F_Email_Inform</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="Task_InformCustomer" name="Endkunde erhält Bestätigung: AG meldet sich persönlich">
      <bpmn:incoming>F_Email_Inform</bpmn:incoming>
      <bpmn:outgoing>F_Inform_End</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_Consultation" name="Prozess beendet">
      <bpmn:incoming>F_Inform_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_Start_Questions" sourceRef="StartEvent_1" targetRef="Task_Questions"/>
    <bpmn:sequenceFlow id="F_Questions_Contact" sourceRef="Task_Questions" targetRef="Task_Contact"/>
    <bpmn:sequenceFlow id="F_Contact_Submit" sourceRef="Task_Contact" targetRef="Task_Submit"/>
