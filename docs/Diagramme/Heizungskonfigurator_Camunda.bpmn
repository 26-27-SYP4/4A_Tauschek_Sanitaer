        <bpmn:flowNodeRef>EndEvent_AnfrageErfasst</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PDF</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EmailFehlerLog</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Email</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EmailFirma</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Web" name="Web-Konfigurator">
        <bpmn:flowNodeRef>Task_LeadErstellen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StatusVerloren</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Verloren</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Kunde" name="Kunde">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
