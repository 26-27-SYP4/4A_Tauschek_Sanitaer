        <bpmn:flowNodeRef>Task_IndividuellesAngebot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AngebotAnpassen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MontagePlanen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Montage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StatusGewonnen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Gewonnen</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Backend" name="Backend / Datenbank">
        <bpmn:flowNodeRef>Task_Validieren</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Regeln</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Automatisch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Bloecke</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Kosten</bpmn:flowNodeRef>
