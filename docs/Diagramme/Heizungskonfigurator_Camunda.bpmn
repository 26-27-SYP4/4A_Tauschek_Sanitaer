  <bpmn:process id="Process_Heizung" name="Heizungs-Konfigurator – Anfrage bis Montage" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Mitarbeiter" name="Mitarbeiter / Administration">
        <bpmn:flowNodeRef>Task_FlagBeratung</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LeadPruefen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Kontaktieren</bpmn:flowNodeRef>
