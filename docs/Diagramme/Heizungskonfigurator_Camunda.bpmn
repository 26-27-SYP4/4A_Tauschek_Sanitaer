        <bpmn:flowNodeRef>Task_AngebotAnsehen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Akzeptiert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AuftragBestaetigen</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Kunde öffnet den Konfigurator" />
    <bpmn:task id="Task_Website" name="Konfigurator auf der Website öffnen" />
    <bpmn:userTask id="Task_Fragen" name="Fragen zur Heizung und zum Gebäude beantworten" />
    <bpmn:userTask id="Task_Kontakt" name="Kontaktdaten und Datenschutz-Einwilligung eingeben" />
    <bpmn:userTask id="Task_Absenden" name="Anfrage absenden" />
    <bpmn:serviceTask id="Task_LeadErstellen" name="Lead anlegen" />
    <bpmn:serviceTask id="Task_Validieren" name="Eingaben serverseitig prüfen" />
    <bpmn:serviceTask id="Task_Regeln" name="Antworten und Konfigurationsregeln auswerten" />
    <bpmn:exclusiveGateway id="Gateway_Automatisch" name="Automatische Schätzung möglich?" />
    <bpmn:serviceTask id="Task_Bloecke" name="Passende Angebotsblöcke auswählen" />
    <bpmn:serviceTask id="Task_Kosten" name="Preisbereich berechnen" />
    <bpmn:serviceTask id="Task_LeadSpeichern" name="Lead und Ergebnis dauerhaft speichern" />
    <bpmn:serviceTask id="Task_FlagBeratung" name="Lead für persönliche Beratung markieren" />
    <bpmn:receiveTask id="Task_Kundenmail" name="E-Mail / Rückmeldung zum weiteren Ablauf erhalten" />
    <bpmn:userTask id="Task_LeadPruefen" name="Lead in der Administration prüfen">
      <bpmn:incoming>Flow_00ykh1l</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Kontaktieren" name="Kunden kontaktieren" />
    <bpmn:userTask id="Task_Beratung" name="Persönliche Beratung durchführen" />
    <bpmn:userTask id="Task_VorOrt" name="Bei Bedarf Vor-Ort-Termin durchführen" />
    <bpmn:userTask id="Task_IndividuellesAngebot" name="Individuelles Angebot erstellen" />
    <bpmn:userTask id="Task_AngebotAnpassen" name="Angebot besprechen und anpassen" />
    <bpmn:userTask id="Task_AngebotAnsehen" name="Angebot prüfen" />
    <bpmn:exclusiveGateway id="Gateway_Akzeptiert" name="Kunde nimmt Angebot an?" />
    <bpmn:userTask id="Task_AuftragBestaetigen" name="Auftrag bestätigen" />
    <bpmn:userTask id="Task_MontagePlanen" name="Ausführung und Termin planen" />
    <bpmn:userTask id="Task_Montage" name="Heizung installieren" />
    <bpmn:userTask id="Task_StatusGewonnen" name="Lead auf „Gewonnen“ setzen" />
    <bpmn:userTask id="Task_StatusVerloren" name="Lead auf „Verloren“ setzen" />
    <bpmn:endEvent id="EndEvent_AnfrageErfasst" name="Anfrage erfasst" />
    <bpmn:endEvent id="EndEvent_Gewonnen" name="Heizung installiert" />
    <bpmn:endEvent id="EndEvent_Verloren" name="Anfrage nicht weiterverfolgt" />
    <bpmn:serviceTask id="Task_PDF" name="PDF mit Blöcken, Annahmen und Hinweisen erstellen" />
    <bpmn:serviceTask id="Task_EmailFehlerLog" name="E-Mail-Fehler protokollieren und Wiederholung ermöglichen" />
    <bpmn:exclusiveGateway id="Gateway_Email" name="E-Mail erfolgreich versendet?" />
    <bpmn:sendTask id="Task_EmailFirma" name="Benachrichtigung an Mitarbeiter senden">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>Flow_00ykh1l</bpmn:outgoing>
    </bpmn:sendTask>
